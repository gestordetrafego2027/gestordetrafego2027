# --- SITE CONFIGURATION ---
# The public URL of your deployed application (required for SEO and canonical links)
# Example: https://app.housemazzutti.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- SERVER CONFIGURATION ---
# The port the application will run on in the container
PORT=3000
# Node environment (development, production, test)
NODE_ENV=production

# --- SUPABASE ---
# URL pública do projeto Supabase (formato: https://<ref>.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=
# Chave pública (publishable / anon) — segura para expor no bundle do cliente
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chave service-role — APENAS SERVIDOR, nunca exposta ao bundle do cliente
SUPABASE_SERVICE_ROLE_KEY=
# Ref do projeto Supabase (string curta antes de .supabase.co)
SUPABASE_PROJECT_REF=

# --- SECURITY & ANALYTICS (Optional) ---
# Add your Google Analytics ID, API Keys, or Secrets below
# NEXT_PUBLIC_GA_ID=
# API_SECRET_KEY=
