# Mercado Pago (Academy — LEGADO, remover após migração para Stripe)
# MP_ACCESS_TOKEN=

# Feature flags — master OFF até Sprint 8
FEATURE_STORE_ENABLED=false
# Espelho client-side do flag acima (precisa estar sincronizado).
# Sem isso, CartButton no header e /carrinho ficam ocultos no browser.
NEXT_PUBLIC_FEATURE_STORE_ENABLED=false
FEATURE_SUBSCRIPTIONS_ENABLED=false
FEATURE_ACADEMY_STRIPE_ENABLED=false