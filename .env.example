# ─────────────────────────────────────────────
# HOUSE MAZZUTTI — E-COMMERCE ENV TEMPLATE
# Copie para .env.local e preencha os valores.
# NUNCA commitar .env.local ou qualquer segredo.
# ─────────────────────────────────────────────

# App
NEXT_PUBLIC_SITE_URL=https://housemazzutti.com
NODE_ENV=development

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=
SUPABASE_PROJECT_REF=

# Stripe (preencher no Sprint 3)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_TAX_ENABLED=false

# E-mail (Resend)
RESEND_API_KEY=re_...
EMAIL_FROM=House Mazzutti <contato@mztgrupo.com>

# Antifraude — reCAPTCHA v3 (Sprint 7)
# Site key: exposta ao browser (forms + auth). DEVE ter o prefixo NEXT_PUBLIC_.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
# Compat: mantida para referência; o cliente usa a NEXT_PUBLIC_ acima.
RECAPTCHA_SITE_KEY=
# Secret key: usada no servidor (Next API + server actions).
RECAPTCHA_SECRET_KEY=
# IMPORTANTE: configure RECAPTCHA_SECRET_KEY também nos secrets da Edge Function
# submit_lead no Supabase, senão os leads dos formulários não são verificados:
#   supabase secrets set RECAPTCHA_SECRET_KEY=xxxx --project-ref <ref>

# Rate limit — Upstash Redis (Sprint 7)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Observabilidade
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# Analytics — Meta Pixel + Google Analytics 4
NEXT_PUBLIC_FB_PIXEL_ID=
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Fiscal — NFE.io (Sprint 5)
# CNPJ emissor: 64.448.222/0001-54 — HOUSE MAZZUTTI PRODUCOES LTDA
# Regime: Simples Nacional — NFS-e municipal SP
NFEIO_API_KEY=
NFEIO_COMPANY_ID=
NFEIO_ENVIRONMENT=Development

# Mercado Pago (Academy — LEGADO, remover após migração para Stripe)
# MP_ACCESS_TOKEN=

# Feature flags
FEATURE_STORE_ENABLED=false
FEATURE_SUBSCRIPTIONS_ENABLED=false
FEATURE_ACADEMY_STRIPE_ENABLED=false
FEATURE_ASAAS_ENABLED=false
# Mesma flag exposta ao client para o seletor Pix/Boleto no carrinho
NEXT_PUBLIC_FEATURE_ASAAS_ENABLED=false

# Asaas (Sprint 9 — Pix + Boleto)
# Sandbox: https://www.asaas.com/registrar (Modo Sandbox)
ASAAS_API_KEY=
ASAAS_ENV=sandbox
ASAAS_WEBHOOK_TOKEN=

# Métodos de pagamento expostos no cliente (informativo)
NEXT_PUBLIC_PAYMENT_METHODS=card,pix,boleto

# Stripe Price IDs dos Livros (gerado por: npm run seed:books)
STRIPE_PRICE_MARKETING_PARA_MODELOS=price_...
STRIPE_PRICE_PRECO_DA_RELEVANCIA=price_...

# Entrega digital — URL do PDF (relativa em /public/downloads/ ou absoluta)
# Quando migrar pra Supabase Storage, gerar signed URL via webhook em vez de hardcode.
DOWNLOAD_URL_MARKETING_PARA_MODELOS=/downloads/marketing-para-modelos-hmzt-vol-01.pdf
DOWNLOAD_URL_PRECO_DA_RELEVANCIA=/downloads/preco-da-relevancia-hmzt-vol-02.pdf

# Instagram — seção "Últimos conteúdos" na home (src/lib/instagram.ts)
# Token de longa duração de conta Business/Creator (@housemazzutti).
# Sem token, a seção usa src/data/instagram-curated.json; sem os dois, mostra só o CTA do perfil.
INSTAGRAM_ACCESS_TOKEN=
# Opcional: ID da conta IG Business. Preenchido → busca via graph.facebook.com;
# vazio → busca via graph.instagram.com/me/media (Instagram Login).
INSTAGRAM_BUSINESS_ACCOUNT_ID=
# Opcional: versão da Graph API (padrão v21.0)
INSTAGRAM_GRAPH_VERSION=
